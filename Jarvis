static string ora_acum() {
    time_t t = time(0);
    tm* z = localtime(&t);
    char b[16];
    snprintf(b, sizeof b, "%d:%02d", z->tm_hour, z->tm_min);
    return b;
}
static string data_azi() {
    static const char* zile[7] = { "duminic\xC4\x83", "luni", "mar\xC8\x9Bi", "miercuri", "joi", "vineri", "s\xC3\xA2mb\xC4\x83t\xC4\x83" };
    static const char* luni[12] = { "ianuarie", "februarie", "martie", "aprilie", "mai", "iunie", "iulie",
                                    "august", "septembrie", "octombrie", "noiembrie", "decembrie" };
    time_t t = time(0);
    tm* z = localtime(&t);
    char b[64];
    snprintf(b, sizeof b, "%s, %d %s %d", zile[z->tm_wday], z->tm_mday, luni[z->tm_mon], z->tm_year + 1900);
    return b;
}

// ---------------------------------------------------------------------
//  generare
// ---------------------------------------------------------------------
static mt19937 rng((unsigned)time(0));
static float temp_gand = 0.2f, temp_rasp = 0.45f;
static bool arata_gand = true;

static int alege(float temp) {
    float l[V];
    for (int v = 0; v < V; v++) l[v] = logits[v];
    l[BOS] = l[TU] = l[GAND] = l[JARVIS] = l[GATA] = -1e30f;
    int best = 0;
    for (int v = 1; v < V; v++) if (l[v] > l[best]) best = v;
    if (temp < 0.01f) return best;
    float p[V], s = 0;
    for (int v = 0; v < V; v++) { p[v] = expf((l[v] - l[best]) / temp); if (p[v] < 0.08f) p[v] = 0; s += p[v]; }
    float r = uniform_real_distribution<float>(0.f, s)(rng);
    for (int v = 0; v < V; v++) { r -= p[v]; if (r <= 0 && p[v] > 0) return v; }
    return best;
}

// scrie caracter cu caracter pana la sfarsitul randului
static string genereaza(float temp, bool afiseaza, bool unelte) {
    string text;
    for (int n = 0; n < 360; n++) {
        int v = alege(temp);
        if (v == NL) { adauga(NL); break; }
        if (v == CEAS || v == DATA) {
            adauga(v);
            string rez = (v == CEAS) ? ora_acum() : data_azi();
            if (afiseaza) { printf("[%s]", rez.c_str()); fflush(stdout); }
            text += rez;
            vector<int> t = codifica(rez);
            for (size_t i = 0; i < t.size(); i++) adauga(t[i]);
            adauga(GATA);
            continue;
        }
        adauga(v);
        text += VOC[v];
        if (afiseaza) { printf("%s", VOC[v]); fflush(stdout); }
        (void)unelte;
    }
    return text;
}

static void conversatie_noua() {
    ture.clear();
    tura_cur.clear();
    ctx.clear();
    hraneste(BOS);
}

int main() {
#ifdef _WIN32
    SetConsoleOutputCP(65001);
    SetConsoleCP(65001);
#endif
    printf("Pornesc Jarvis...\n");
    incarca_greutati();
    conversatie_noua();
    printf("\n=============================================================\n");
    printf(" J.A.R.V.I.S. 2.0 | transformer de 819.456 de parametri\n");
    printf(" scris de la zero \xC3\xAEn C++, g\xC3\xA2nde\xC8\x99te \xC3\xAEnainte s\xC4\x83 r\xC4\x83spund\xC4\x83\n");
    printf("=============================================================\n");
    printf(" Comenzi: /gand (arat\xC4\x83/ascunde g\xC3\xA2ndurile), /nou, /temp 0.5, stop\n");

    string linie;
    while (true) {
        printf("\nTu: ");
        fflush(stdout);
        if (!getline(cin, linie)) break;
        string m = normalizeaza(linie);
        if (m == "stop" || m == "/stop" || m == "exit" || m == "/exit" || m == "iesire") break;
        if (m == "/gand") {
            arata_gand = !arata_gand;
            printf(arata_gand ? "(g\xC3\xA2ndurile sunt vizibile)\n" : "(g\xC3\xA2ndurile sunt ascunse)\n");
            continue;
        }
        if (m == "/nou") { conversatie_noua(); printf("(conversa\xC8\x9Bie nou\xC4\x83)\n"); continue; }
        if (m.compare(0, 5, "/temp") == 0) {
            float t = (float)atof(m.c_str() + 5);
            if (t < 0) t = 0;
            if (t > 2) t = 2;
            temp_rasp = t;
            temp_gand = t < 0.2f ? t : 0.2f;
            printf("(temperatura: %.2f)\n", t);
            continue;
        }
        if (m.empty()) continue;

        tura_cur.clear();
        if ((int)ctx.size() + (int)m.size() + 160 > T) reconstruieste();
        adauga(TU);
        vector<int> u = codifica(m);
        for (size_t i = 0; i < u.size(); i++) adauga(u[i]);
        adauga(NL);
        adauga(GAND);
        printf(arata_gand ? "  [g\xC3\xA2nd] " : "Jarvis: ");
        fflush(stdout);
        string gand = genereaza(temp_gand, arata_gand, true);
        if (arata_gand) printf("\nJarvis: ");
        fflush(stdout);
        adauga(JARVIS);
        genereaza(temp_rasp, true, false);
        printf("\n");
        Tura tr;
        tr.tok = tura_cur;
        tr.retinuta = gand.find("re\xC8\x9Bin") != string::npos || gand.find("Re\xC8\x9Bin") != string::npos;
        ture.push_back(tr);
        tura_cur.clear();
    }
    printf("La revedere, domnule.\n");
    return 0;
}

