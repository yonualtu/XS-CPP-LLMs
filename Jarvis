// ---------------------------------------------------------------------
//  greutatile (decodate din textul base64 de la finalul fisierului)
// ---------------------------------------------------------------------
extern const char* const GREUTATI[];
extern const int NGREUTATI;

static vector<float> wte, ln1w, ln1b, qkvw, qkvb, attw, attb, ln2w, ln2b, fcw, fcb, prw, prb, lnfw, lnfb, lmw;

static int b64(char c) {
    if (c >= 'A' && c <= 'Z') return c - 'A';
    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
    if (c >= '0' && c <= '9') return c - '0' + 52;
    if (c == '+') return 62;
    if (c == '/') return 63;
    return -1;
}

static float din_half(unsigned short h) {
    int semn = (h >> 15) & 1, e = (h >> 10) & 31, m = h & 1023;
    float v;
    if (e == 0) v = ldexp((float)m, -24);
    else if (e == 31) v = 65504.f;
    else v = ldexp((float)(m + 1024), e - 25);
    return semn ? -v : v;
}

static void incarca_greutati() {
    vector<unsigned char> raw;
    raw.reserve(1000000);
    int acc = 0, nb = 0;
    for (int i = 0; i < NGREUTATI; i++)
        for (const char* p = GREUTATI[i]; *p; p++) {
            int v = b64(*p);
            if (v < 0) continue;
            acc = (acc << 6) | v;
            nb += 6;
            if (nb >= 8) { nb -= 8; raw.push_back((unsigned char)((acc >> nb) & 255)); }
        }
    size_t marimi[16] = {
        (size_t)V * C, (size_t)L * C, (size_t)L * C, (size_t)L * C * 3 * C, (size_t)L * 3 * C,
        (size_t)L * C * C, (size_t)L * C, (size_t)L * C, (size_t)L * C, (size_t)L * C * 4 * C, (size_t)L * 4 * C,
        (size_t)L * 4 * C * C, (size_t)L * C, (size_t)C, (size_t)C, (size_t)C * V };
    vector<float>* tinte[16] = { &wte, &ln1w, &ln1b, &qkvw, &qkvb, &attw, &attb, &ln2w, &ln2b,
                                 &fcw, &fcb, &prw, &prb, &lnfw, &lnfb, &lmw };
    size_t N = 0;
    for (int i = 0; i < 16; i++) N += marimi[i];
    if (raw.size() < N + N / 32) { printf("Greutatile sunt incomplete!\n"); exit(1); }
    // N valori int8, apoi cate o scala (float16) pentru fiecare grup de 64
    size_t k = 0;
    for (int i = 0; i < 16; i++) {
        tinte[i]->resize(marimi[i]);
        for (size_t j = 0; j < marimi[i]; j++, k++) {
            size_t g = k / 64;
            unsigned short h = (unsigned short)(raw[N + 2 * g] | (raw[N + 2 * g + 1] << 8));
            (*tinte[i])[j] = (float)(signed char)raw[k] * din_half(h);
        }
    }
}

// ---------------------------------------------------------------------
//  forward pentru un singur caracter, cu memorie (KV cache)
// ---------------------------------------------------------------------
static vector<float> kcache((size_t)L * T * C), vcache((size_t)L * T * C);
static float x[C], xn[C], qkv[3 * C], ao[C], tmp[4 * C], logits[V], scor[T];

static void layernorm(float* out, const float* in, const float* w, const float* b) {
    float m = 0, v = 0;
    for (int c = 0; c < C; c++) m += in[c];
    m /= C;
    for (int c = 0; c < C; c++) v += (in[c] - m) * (in[c] - m);
    v /= C;
    float r = 1.f / sqrtf(v + 1e-5f);
    for (int c = 0; c < C; c++) out[c] = (in[c] - m) * r * w[c] + b[c];
}

// out = in * W + b, cu W stocata [n_in][n_out] (n_out multiplu de 2)
static void matvec(float* out, const float* in, const float* W, const float* b, int n_in, int n_out) {
    for (int j = 0; j < n_out; j++) out[j] = b ? b[j] : 0.f;
    const float* w = W;
    for (int i = 0; i < n_in; i++) {
        float xi = in[i];
        float* o = out;
        float* sf = out + n_out;
        while (o < sf) {   // scris "desfacut", ca sa mearga repede si fara optimizari
            o[0] += xi * w[0]; o[1] += xi * w[1];
            o += 2; w += 2;
        }
    }
}

// RoPE: roteste perechile de componente cu un unghi care depinde de pozitie
static float rcos[HS / 2], rsin[HS / 2];
static void rope_unghiuri(int pos) {
    for (int i = 0; i < HS / 2; i++) {
        double ang = pos * pow(10000.0, -2.0 * i / HS);
        rcos[i] = (float)cos(ang);
        rsin[i] = (float)sin(ang);
    }
}
static void rope(float* v) {
    for (int h = 0; h < NH; h++)
        for (int i = 0; i < HS / 2; i++) {
            float* p = v + h * HS + 2 * i;
            float a = p[0], b = p[1];
            p[0] = a * rcos[i] - b * rsin[i];
            p[1] = a * rsin[i] + b * rcos[i];
        }
}

static void pas(int tok, int pos) {
    for (int c = 0; c < C; c++) x[c] = wte[(size_t)tok * C + c];
    float scale = 1.f / sqrtf((float)HS);
    rope_unghiuri(pos);
    for (int l = 0; l < L; l++) {
        layernorm(xn, x, &ln1w[l * C], &ln1b[l * C]);
        matvec(qkv, xn, &qkvw[(size_t)l * C * 3 * C], &qkvb[l * 3 * C], C, 3 * C);
        rope(qkv);
        rope(qkv + C);
        float* kc = &kcache[((size_t)l * T + pos) * C];
        float* vc = &vcache[((size_t)l * T + pos) * C];
        for (int c = 0; c < C; c++) { kc[c] = qkv[C + c]; vc[c] = qkv[2 * C + c]; }
        for (int h = 0; h < NH; h++) {
            const float* q = qkv + h * HS;
            float mx = -1e30f;
            const float* k = &kcache[(size_t)l * T * C + h * HS];
            for (int t = 0; t <= pos; t++, k += C) {
                float s0 = 0, s1 = 0, s2 = 0, s3 = 0;
                for (int d = 0; d < HS; d += 4) {
                    s0 += q[d] * k[d]; s1 += q[d + 1] * k[d + 1];
                    s2 += q[d + 2] * k[d + 2]; s3 += q[d + 3] * k[d + 3];
                }
                scor[t] = (s0 + s1 + s2 + s3) * scale;
                if (scor[t] > mx) mx = scor[t];
            }
            float sum = 0;
            for (int t = 0; t <= pos; t++) { scor[t] = expf(scor[t] - mx); sum += scor[t]; }
            float* o = ao + h * HS;
            for (int d = 0; d < HS; d++) o[d] = 0;
            const float* vv = &vcache[(size_t)l * T * C + h * HS];
            float inv = 1.f / sum;
            for (int t = 0; t <= pos; t++, vv += C) {
                float a = scor[t] * inv;
                for (int d = 0; d < HS; d += 4) {
                    o[d] += a * vv[d]; o[d + 1] += a * vv[d + 1];
                    o[d + 2] += a * vv[d + 2]; o[d + 3] += a * vv[d + 3];
                }
            }
        }
        matvec(tmp, ao, &attw[(size_t)l * C * C], &attb[l * C], C, C);
        for (int c = 0; c < C; c++) x[c] += tmp[c];
        layernorm(xn, x, &ln2w[l * C], &ln2b[l * C]);
        matvec(tmp, xn, &fcw[(size_t)l * C * 4 * C], &fcb[l * 4 * C], C, 4 * C);
        for (int i = 0; i < 4 * C; i++) {   // GELU
            float u = tmp[i];
            tmp[i] = 0.5f * u * (1.f + tanhf(0.7978845608f * (u + 0.044715f * u * u * u)));
        }
        float y[C];
        matvec(y, tmp, &prw[(size_t)l * 4 * C * C], &prb[l * C], 4 * C, C);
        for (int c = 0; c < C; c++) x[c] += y[c];
    }
    layernorm(xn, x, &lnfw[0], &lnfb[0]);
    matvec(logits, xn, &lmw[0], 0, C, V);
}

// ---------------------------------------------------------------------
//  contextul conversatiei
// ---------------------------------------------------------------------
struct Tura { vector<int> tok; bool retinuta; };
static vector<Tura> ture;
static vector<int> ctx;       // tot ce e in memorie acum
static vector<int> tura_cur;  // tura care se scrie acum

static void hraneste(int tok) { pas(tok, (int)ctx.size()); ctx.push_back(tok); }

// cand se umple contextul: pastram turele marcate "retin" si pe cele mai noi
static void reconstruieste() {
    int buget = T - 120 - (int)tura_cur.size();
    if (buget < 0) buget = 0;
    vector<bool> ia(ture.size(), false);
    int folosit = 1;
    for (size_t i = 0; i < ture.size(); i++)
        if (ture[i].retinuta && folosit + (int)ture[i].tok.size() <= buget) { ia[i] = true; folosit += (int)ture[i].tok.size(); }
    for (int i = (int)ture.size() - 1; i >= 0; i--)
        if (!ia[i] && folosit + (int)ture[i].tok.size() <= buget) { ia[i] = true; folosit += (int)ture[i].tok.size(); }
        else if (!ia[i]) break;
    vector<int> nou(1, BOS);
    for (size_t i = 0; i < ture.size(); i++)
        if (ia[i]) nou.insert(nou.end(), ture[i].tok.begin(), ture[i].tok.end());
    nou.insert(nou.end(), tura_cur.begin(), tura_cur.end());
    if ((int)nou.size() > T - 8) nou.erase(nou.begin() + 1, nou.begin() + 1 + ((int)nou.size() - (T - 8)));
    ctx.clear();
    for (size_t i = 0; i < nou.size(); i++) hraneste(nou[i]);
}

static void adauga(int tok) {
    if ((int)ctx.size() >= T) reconstruieste();
    tura_cur.push_back(tok);
    hraneste(tok);
}

// ---------------------------------------------------------------------
//  text <-> caractere
// ---------------------------------------------------------------------
static vector<int> codifica(const string& s) {   // exact, pentru textul uneltelor
    vector<int> r;
    size_t i = 0;
    while (i < s.size()) {
        int best = -1, blen = 0;
        for (int v = 8; v < V; v++) {
            int n = (int)strlen(VOC[v]);
            if (n > blen && s.compare(i, n, VOC[v]) == 0) { best = v; blen = n; }
        }
        if (best < 0) { i++; continue; }
        r.push_back(best);
        i += blen;
    }
    return r;
}

// ce scrie utilizatorul: litere mici, fara diacritice, doar caractere cunoscute
static string normalizeaza(const string& s) {
    string r;
    size_t i = 0;
    while (i < s.size()) {
        unsigned char c = (unsigned char)s[i];
        unsigned cp;
        int n;
        if (c < 0x80) { cp = c; n = 1; }
        else if ((c >> 5) == 6 && i + 1 < s.size()) { cp = ((c & 31) << 6) | (s[i + 1] & 63); n = 2; }
        else if ((c >> 4) == 14 && i + 2 < s.size()) { cp = ((c & 15) << 12) | ((s[i + 1] & 63) << 6) | (s[i + 2] & 63); n = 3; }
        else { i++; continue; }
        i += n;
        char o = 0;
        if (cp < 128) {
            o = (char)tolower((int)cp);
            if (o == '\t') o = ' ';
        } else if (cp == 0x103 || cp == 0x102 || cp == 0xE2 || cp == 0xC2) o = 'a';
        else if (cp == 0xEE || cp == 0xCE) o = 'i';
        else if (cp == 0x219 || cp == 0x218 || cp == 0x15F || cp == 0x15E) o = 's';
        else if (cp == 0x21B || cp == 0x21A || cp == 0x163 || cp == 0x162) o = 't';
        else if (cp == 0x201E || cp == 0x201D || cp == 0x201C || cp == 0xAB || cp == 0xBB) o = '"';
        else if (cp == 0x2019 || cp == 0x2018) o = '\'';
        else if (cp == 0xD7) o = 'x';
        else if (cp == 0xF7) o = ':';
        else if (cp == 0x2212 || cp == 0x2013 || cp == 0x2014) o = '-';
        if (!o) continue;
        bool ok = (o >= 'a' && o <= 'z') || (o >= '0' && o <= '9') || strchr(" !\"'()*+,-./:;<=>?%^", o);
        if (!ok) continue;
        if (o == ' ' && (r.empty() || r[r.size() - 1] == ' ')) continue;
        r += o;
    }
    while (!r.empty() && r[r.size() - 1] == ' ') r.erase(r.size() - 1);
    if (r.size() > 200) r.resize(200);
    return r;
}

