const int L = 4;           // straturi transformer
const int NH = 4;          // capete de atentie
const int HS = C / NH;

enum { BOS = 0, TU = 1, GAND = 2, JARVIS = 3, NL = 4, CEAS = 5, DATA = 6, GATA = 7 };

